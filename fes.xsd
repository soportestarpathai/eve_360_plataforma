<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:fes="http://www.uif.shcp.gob.mx/recepcion/fes"
            targetNamespace="http://www.uif.shcp.gob.mx/recepcion/fes"
            elementFormDefault="qualified">
  <xsd:element name="archivo" type="fes:archivo_type"/>

  <xsd:complexType name="archivo_type">
    <xsd:sequence>
      <xsd:element name="informe" type="fes:informe_type" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="informe_type">
    <xsd:sequence>
      <xsd:element name="mes_reportado" type="fes:mes_reportado_type"/>
      <xsd:element name="tribunal_dependencia" type="fes:tribunal_type"/>
      <xsd:element name="aviso" type="fes:aviso_type" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:element name="version" type="fes:version_type" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="tribunal_type">
    <xsd:sequence>
      <xsd:element name="clave_tribunal_dependencia" type="fes:clave_tribunal_type"/>
      <xsd:element name="clave_actividad" type="fes:clave_actividad_type"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="aviso_type">
    <xsd:sequence>
      <xsd:element name="referencia_aviso" type="fes:referencia_aviso_type"/>
      <xsd:element name="modificatorio" type="fes:modificatorio_type" minOccurs="0"/>
      <xsd:element name="prioridad" type="fes:prioridad_type"/>
      <xsd:element name="alerta" type="fes:alerta_type"/>
      <xsd:element name="detalle_operaciones" type="fes:operaciones_type"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="modificatorio_type">
    <xsd:sequence>
      <xsd:element name="folio_modificacion" type="fes:folio_modificacion_type"/>
      <xsd:element name="descripcion_modificacion" type="fes:descripcion_1-3000_type"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="alerta_type">
    <xsd:sequence>
      <xsd:element name="tipo_alerta" type="fes:tipo_alerta_type"/>
      <xsd:element name="descripcion_alerta" type="fes:descripcion_1-3000_type" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="operaciones_type">
    <xsd:sequence>
      <xsd:element name="datos_operacion" type="fes:operacion_type" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="operacion_type">
    <xsd:sequence>
      <xsd:element name="fecha_operacion" type="fes:fecha_type"/>
      <xsd:element name="tipo_actividad" type="fes:actividad_type"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="actividad_type">
    <xsd:choice>
      <xsd:element name="derechos_inmuebles" type="fes:any_activity_type"/>
      <xsd:element name="otorgamiento_poder" type="fes:any_activity_type"/>
      <xsd:element name="constitucion_personas_morales" type="fes:any_activity_type"/>
      <xsd:element name="modificacion_patrimonial" type="fes:any_activity_type"/>
      <xsd:element name="contrato_mutuo_credito" type="fes:any_activity_type"/>
      <xsd:element name="avaluo" type="fes:any_activity_type"/>
    </xsd:choice>
  </xsd:complexType>

  <xsd:complexType name="any_activity_type" mixed="true">
    <xsd:sequence>
      <xsd:any namespace="##targetNamespace" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:simpleType name="clave_actividad_type"><xsd:restriction base="xsd:string"><xsd:pattern value="FES"/><xsd:length value="3"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="clave_tribunal_type"><xsd:restriction base="xsd:string"><xsd:pattern value="[A-ZÑ&amp;%+]{3,4}\d{6}[A-Z0-9]{3}"/><xsd:minLength value="12"/><xsd:maxLength value="13"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="mes_reportado_type"><xsd:restriction base="xsd:string"><xsd:pattern value="\d{4}[0|1]\d{1}"/><xsd:length value="6"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="referencia_aviso_type"><xsd:restriction base="xsd:string"><xsd:pattern value="[A-ZÑ0-9]{1,14}"/><xsd:minLength value="1"/><xsd:maxLength value="14"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="prioridad_type"><xsd:restriction base="xsd:string"><xsd:pattern value="[12]"/><xsd:length value="1"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="tipo_alerta_type"><xsd:restriction base="xsd:string"><xsd:pattern value="\d{3,4}"/><xsd:minLength value="3"/><xsd:maxLength value="4"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="fecha_type"><xsd:restriction base="xsd:string"><xsd:length value="8"/><xsd:pattern value="\d{8}"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="folio_modificacion_type"><xsd:restriction base="xsd:string"><xsd:pattern value="\d{4}\-\d{1,9}"/><xsd:minLength value="6"/><xsd:maxLength value="14"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="descripcion_1-3000_type"><xsd:restriction base="xsd:string"><xsd:minLength value="1"/><xsd:maxLength value="3000"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="version_type"><xsd:restriction base="xsd:string"><xsd:pattern value="V3.2"/></xsd:restriction></xsd:simpleType>
</xsd:schema>
